#include "Shared.xcconfig"
#include? "Secrets.xcconfig"

// Debug Firebase app: "Tatum Tech Debug".
PRODUCT_BUNDLE_IDENTIFIER = com.tatumgames.tatumtech.ios.debug
APP_DISPLAY_NAME = Tatum Tech Debug
FIREBASE_CONFIG_DIR = Debug
FIREBASE_CONFIG_REQUIRED = NO

// Debug-only switches. Override in Secrets.xcconfig, for example:
//   TATUM_TECH_ENVIRONMENT = stage
//   TATUM_TECH_DATA_SOURCE = LOCAL_JSON
