// Copy to Config/Secrets.xcconfig (git-ignored) and fill in locally. Never commit the copy.

// Apple Developer team used for signing.
// DEVELOPMENT_TEAM = ABCDE12345

// Optional `x-api-key` for the Tatum Tech API.
// TATUM_TECH_API_KEY =

// Google iOS OAuth client for com.tatumgames.tatumtech.ios (and .ios.debug for Debug builds),
// created in the Google Cloud console under Credentials.
// GOOGLE_IOS_CLIENT_ID = 1234567890-abcdef.apps.googleusercontent.com
// GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdef

// Debug-only data overrides. Debug builds use the stage API unless this opts into production.
// TATUM_TECH_ENVIRONMENT = production
// TATUM_TECH_DATA_SOURCE = LOCAL_JSON
